<plist version="1.0">
<dict>
	<!-- Hardened runtime with no exceptions: no sandbox (Full Disk Access is
	     granted by the user), no network, no Apple Events, no library-validation
	     exemption (only system frameworks are loaded). -->
</dict>
</plist>
